PORT=5000
NODE_ENV=development
MONGO_URI=

# Used only to create the initial admin if this email is not already in MongoDB.
# Existing admin records and passwords are never overwritten.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Replace these placeholders with credentials for a real SMTP account.
# Gmail: use an App Password (not your normal account password).
# Port 465 uses implicit TLS; port 587 uses STARTTLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM="Jai Janardan Auto <your-email@gmail.com>"

# Use the exact frontend origin (5173 or 5174 during local development).
# Use an HTTPS origin in production.
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
